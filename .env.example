# gitEnglish Practice Genie — AI configuration
# Copy this file to .env and fill in your key. On Railway, set these as
# environment variables in the service settings instead (vite bakes them in at build time).

# OpenRouter API key (https://openrouter.ai/keys). DEEPSEEK_API_KEY is also accepted.
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
