# gitEnglish Practice Genie — AI configuration
# Copy this file to .env and fill in your key. On Railway, set these as
# environment variables in the service settings instead (vite bakes them in at build time).

# OpenRouter API key (https://openrouter.ai/keys). DEEPSEEK_API_KEY is also accepted.
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Hub handoff + telemetry (server-side only; read by server.ts, never by the
# browser bundle and never passed as a build arg).
# ---------------------------------------------------------------------------

# HS256 secret shared with the hub. Unset = every entry token is treated as
# absent and the module still boots. Never expose it via /version.
# GENIE_JWT_SECRET=

# "true" denies anonymous document requests (403). Only flip this once the hub
# mints ?t= and accepts the bearer on /api/internal/practice-genie/session:
# the session store is in-memory, so a restart would 403 visitors until they
# re-enter through the hub link.
# GENIE_REQUIRE_TOKEN=false

# Hub telemetry ingest. HUB_INGEST_SECRET mirrors the hub's INTERNAL_API_SECRET
# (or SATELLITE_SECRET when that is the one set — the hub uses the first
# non-empty value).
# HUB_INGEST_URL=https://gitenglish.com/api/internal/satellite-telemetry/ingest
# HUB_INGEST_SECRET=
